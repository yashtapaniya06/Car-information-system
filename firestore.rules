rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cars: anyone can read public listings, only authenticated users can write
    match /cars/{carId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Users: only authenticated users can read/write their own user doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Contacts & Ratings: authenticated users only
    match /contacts/{doc} {
      allow read, write: if request.auth != null;
    }

    match /ratings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}