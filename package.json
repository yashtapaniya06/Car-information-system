{
  "name": "crazy-car-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:crazy-car-angular": "node dist/crazy-car-angular/server/server.mjs",
    "start:backend": "node backend/server.js",
    "start:backend:firebase": "cross-env USE_FIREBASE=true node backend/server.js",
    "seed:firestore": "node scripts/seedFirestore.js",
    "audit:depcheck": "depcheck",
    "audit:ts-prune": "ts-prune"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@angular/cdk": "~21.1.2",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "~21.1.2",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/material": "^21.1.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.0",
    "jsdom": "^27.1.0",
    "ts-prune": "^0.10.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
